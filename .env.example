# PaddleOCR API Token from Baidu AI Studio
PADDLE_API_TOKEN=your_api_token_here

# Optional: Override PaddleOCR Jobs API URL (defaults to official PaddleOCR endpoint)
# PADDLE_API_URL=https://paddleocr.aistudio-app.com/api/v2/ocr/jobs

# Optional: Override PaddleOCR model name (defaults to PaddleOCR-VL-1.6)
# PADDLE_MODEL=PaddleOCR-VL-1.6
